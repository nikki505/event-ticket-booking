        <mxCell id="ucNote" value="Verify capacity is included by BOTH booking and cancellation.&lt;br&gt;One shared mechanism guards the capacity change in both&lt;br&gt;directions - this is requirement R11.1." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="700" y="500" width="320" height="70" as="geometry"/></mxCell>
