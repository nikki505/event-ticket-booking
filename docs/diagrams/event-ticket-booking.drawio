  </diagram>
  <diagram name="2. SysML Requirements" id="p-req">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="r0" value="«requirement»&lt;br&gt;&lt;b&gt;Event Ticket Booking&lt;/b&gt;&lt;br&gt;id = R0&lt;br&gt;Manage events and bookings&lt;br&gt;without overselling" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="420" y="40" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="rA" value="«requirement»&lt;br&gt;&lt;b&gt;Access Control&lt;/b&gt;&lt;br&gt;id = R1-R4" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="rE" value="«requirement»&lt;br&gt;&lt;b&gt;Event Management&lt;/b&gt;&lt;br&gt;id = R5-R8" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="290" y="200" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="rB" value="«requirement»&lt;br&gt;&lt;b&gt;Booking&lt;/b&gt;&lt;br&gt;id = R9-R11" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="520" y="200" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="rM" value="«requirement»&lt;br&gt;&lt;b&gt;Booking Management&lt;/b&gt;&lt;br&gt;id = R12-R14" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="750" y="200" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="r11" value="«requirement»&lt;br&gt;&lt;b&gt;No Overbooking&lt;/b&gt;&lt;br&gt;id = R11&lt;br&gt;Reject bookings beyond&lt;br&gt;remaining capacity" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="480" y="340" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="r13" value="«requirement»&lt;br&gt;&lt;b&gt;Release on Cancel&lt;/b&gt;&lt;br&gt;id = R13&lt;br&gt;Cancelling returns seats&lt;br&gt;exactly once" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="750" y="340" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="r111" value="«requirement»&lt;br&gt;&lt;b&gt;Atomic Seat Decrement&lt;/b&gt;&lt;br&gt;id = R11.1&lt;br&gt;The seat count must change in a&lt;br&gt;SINGLE conditional update" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="590" y="520" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="vt" value="«verify»&lt;br&gt;&lt;b&gt;US-10 AC4&lt;/b&gt;&lt;br&gt;Two simultaneous last-seat bookings:&lt;br&gt;exactly one succeeds" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="890" y="520" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="q1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="r0" target="rA"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="q2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="r0" target="rE"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="q3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="r0" target="rB"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="q4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="r0" target="rM"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="q5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="rB" target="r11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="q6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="rM" target="r13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="q7" value="«deriveReqt»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="r11" target="r111"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="q8" value="«deriveReqt»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="r13" target="r111"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="q9" value="«verify»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="vt" target="r111"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="reqNote" value="&lt;b&gt;R11.1 is DERIVED, not requested.&lt;/b&gt;&lt;br&gt;R11 and R13 are both unsatisfiable under concurrent&lt;br&gt;requests unless the seat count changes atomically.&lt;br&gt;Deriving it explicitly turns &quot;be careful&quot; into something&lt;br&gt;a test can prove - see US-10 AC4." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="320" height="110" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3. SysML BDD" id="p-bdd">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="bSys" value="«block»&lt;br&gt;&lt;b&gt;EventTicketBookingSystem&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="450" y="40" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="bWeb" value="«block»&lt;br&gt;&lt;b&gt;WebClient&lt;/b&gt;&lt;br&gt;---&lt;br&gt;parts: Router, AuthContext&lt;br&gt;ops: render, callApi" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="130" y="170" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="bApi" value="«block»&lt;br&gt;&lt;b&gt;ApiServer&lt;/b&gt;&lt;br&gt;---&lt;br&gt;parts: AuthMw, Guards, Validator&lt;br&gt;ops: handleRequest" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="450" y="170" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="bStore" value="«block»&lt;br&gt;&lt;b&gt;DataStore&lt;/b&gt;&lt;br&gt;---&lt;br&gt;ops: findOneAndUpdate, insert" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="790" y="170" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="cAuth" value="«block»&lt;br&gt;&lt;b&gt;AuthController&lt;/b&gt;&lt;br&gt;---&lt;br&gt;register, login" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="330" y="330" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="cEvent" value="«block»&lt;br&gt;&lt;b&gt;EventController&lt;/b&gt;&lt;br&gt;---&lt;br&gt;create, listMine, listPublic,&lt;br&gt;update, cancel, listBookings" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="540" y="330" width="210" height="80" as="geometry"/></mxCell>
        <mxCell id="cBook" value="«block»&lt;br&gt;&lt;b&gt;BookingController&lt;/b&gt;&lt;br&gt;---&lt;br&gt;create, listMine, cancel" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="770" y="330" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="mUser" value="«block»&lt;br&gt;&lt;b&gt;User&lt;/b&gt;&lt;br&gt;---&lt;br&gt;email : String {unique}&lt;br&gt;passwordHash : String&lt;br&gt;role : ORGANISER | ATTENDEE" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="130" y="500" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="mEvent" value="«block»&lt;br&gt;&lt;b&gt;Event&lt;/b&gt;&lt;br&gt;---&lt;br&gt;title, venue, startsAt&lt;br&gt;capacity : Integer&lt;br&gt;seatsRemaining : Integer&lt;br&gt;price : Decimal&lt;br&gt;status : PUBLISHED | CANCELLED" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="420" y="500" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="mBook" value="«block»&lt;br&gt;&lt;b&gt;Booking&lt;/b&gt;&lt;br&gt;---&lt;br&gt;reference : String {unique}&lt;br&gt;quantity : Integer {1..10}&lt;br&gt;status : CONFIRMED | CANCELLED" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="730" y="500" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="b1" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="bSys" target="bWeb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b2" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="bSys" target="bApi"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b3" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="bSys" target="bStore"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="bApi" target="cAuth"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="bApi" target="cEvent"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="bApi" target="cBook"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="bStore" target="mUser"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="bStore" target="mEvent"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="bStore" target="mBook"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b10" value="organises 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="mUser" target="mEvent"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b11" value="books 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="mUser" target="mBook"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b12" value="has 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="mEvent" target="mBook"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="bddNote" value="&lt;b&gt;Why three controllers, not one handler?&lt;/b&gt;&lt;br&gt;The authorisation rules differ per controller:&lt;br&gt;EventController needs organiser role + event ownership,&lt;br&gt;BookingController needs attendee role + booking ownership.&lt;br&gt;Separating them puts each guard at its point of use." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="660" width="340" height="110" as="geometry"/></mxCell>
        <mxCell id="bddNote2" value="&lt;b&gt;seatsRemaining is STORED, not derived&lt;/b&gt; (decision D-004).&lt;br&gt;A stored counter can be changed with one conditional atomic&lt;br&gt;update. A derived count forces read-then-write, which has a&lt;br&gt;race window. Trade-off: the stored value can drift, so&lt;br&gt;US-13 AC4 displays a cross-check total." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="450" y="660" width="360" height="110" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="4. SysML IBD" id="p-ibd">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="iWeb" value="«block» WebClient" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=none;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="260" height="250" as="geometry"/></mxCell>
        <mxCell id="iUI" value="UI Components" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="90" y="100" width="200" height="40" as="geometry"/></mxCell>
        <mxCell id="iCtx" value="AuthContext&lt;br&gt;(holds session token)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="90" y="160" width="200" height="45" as="geometry"/></mxCell>
        <mxCell id="iApiC" value="ApiClient&lt;br&gt;«port» out" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="90" y="225" width="200" height="45" as="geometry"/></mxCell>
        <mxCell id="iSrv" value="«block» ApiServer" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=none;strokeColor=#82b366;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="60" width="300" height="480" as="geometry"/></mxCell>
        <mxCell id="pIn" value="«port» in&lt;br&gt;HTTP :5000" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="440" y="100" width="220" height="40" as="geometry"/></mxCell>
        <mxCell id="mAuth" value="1. AuthMiddleware&lt;br&gt;verify token -&gt; 401" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="440" y="160" width="220" height="40" as="geometry"/></mxCell>
        <mxCell id="mRole" value="2. RoleGuard&lt;br&gt;requireRole() -&gt; 403" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="440" y="215" width="220" height="40" as="geometry"/></mxCell>
        <mxCell id="mOwn" value="3. OwnershipGuard&lt;br&gt;owner == session user -&gt; 403" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="440" y="270" width="220" height="40" as="geometry"/></mxCell>
        <mxCell id="mVal" value="4. Validator&lt;br&gt;field errors -&gt; 400" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="440" y="325" width="220" height="40" as="geometry"/></mxCell>
        <mxCell id="mCtrl" value="5. Controllers" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="440" y="380" width="220" height="40" as="geometry"/></mxCell>
        <mxCell id="pOut" value="«port» out&lt;br&gt;database driver" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="440" y="435" width="220" height="40" as="geometry"/></mxCell>
        <mxCell id="iDs" value="«block» DataStore" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=none;strokeColor=#666666;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="780" y="60" width="260" height="160" as="geometry"/></mxCell>
        <mxCell id="iMongo" value="MongoDB&lt;br&gt;bound to 127.0.0.1:27017" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="810" y="110" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="i1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=none;" edge="1" parent="1" source="iUI" target="iCtx"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=none;" edge="1" parent="1" source="iCtx" target="iApiC"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i3" value="«interface» REST/JSON&lt;br&gt;Authorization: Bearer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="iApiC" target="pIn"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="pIn" target="mAuth"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="mAuth" target="mRole"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="mRole" target="mOwn"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="mOwn" target="mVal"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="mVal" target="mCtrl"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="mCtrl" target="pOut"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i10" value="«interface» driver" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="pOut" target="iMongo"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ibdNote" value="&lt;b&gt;The middleware ORDER is the design, not an accident.&lt;/b&gt;&lt;br&gt;1 before 2: there is no role without an identity.&lt;br&gt;2 before 3: no point loading a resource for a role that cannot touch it.&lt;br&gt;4 last: a malformed body from an unauthorised caller returns 403,&lt;br&gt;not 400 - so the caller learns nothing about the payload shape." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="ibdNote2" value="&lt;b&gt;Client-side validation is a convenience only.&lt;/b&gt;&lt;br&gt;The server assumes the client may be bypassed entirely&lt;br&gt;(decision D-007). SC4 and SC5 are tested by calling the&lt;br&gt;API directly, not through the UI." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="780" y="260" width="300" height="100" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="5. Sequence - W1 Book" id="p-seq">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="sA" value="Attendee" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="40" width="150" height="640" as="geometry"/></mxCell>
        <mxCell id="sC" value="WebClient" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="240" y="40" width="150" height="640" as="geometry"/></mxCell>
        <mxCell id="sG" value="Auth + Guards" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="430" y="40" width="150" height="640" as="geometry"/></mxCell>
        <mxCell id="sB" value="BookingController" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="640" y="40" width="150" height="640" as="geometry"/></mxCell>
        <mxCell id="sD" value="MongoDB" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="870" y="40" width="150" height="640" as="geometry"/></mxCell>
        <mxCell id="m0" value="select event, quantity = 2" style="edgeStyle=none;html=1;fontSize=9;align=center;verticalAlign=bottom;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="135" y="110" as="sourcePoint"/><mxPoint x="315" y="110" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m1" value="POST /api/bookings {eventId, quantity:2}  +  Bearer token" style="edgeStyle=none;html=1;fontSize=9;align=center;verticalAlign=bottom;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="315" y="150" as="sourcePoint"/><mxPoint x="505" y="150" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m2" value="verify token   [invalid -&gt; 401]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;align=left;verticalAlign=middle;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="505" y="195" as="sourcePoint"/><mxPoint x="505" y="221" as="targetPoint"/><Array as="points"><mxPoint x="580" y="195"/><mxPoint x="580" y="221"/></Array></mxGeometry></mxCell>
        <mxCell id="m3" value="requireRole(ATTENDEE)   [organiser -&gt; 403]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;align=left;verticalAlign=middle;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="505" y="240" as="sourcePoint"/><mxPoint x="505" y="266" as="targetPoint"/><Array as="points"><mxPoint x="580" y="240"/><mxPoint x="580" y="266"/></Array></mxGeometry></mxCell>
        <mxCell id="m4" value="forward with req.user" style="edgeStyle=none;html=1;fontSize=9;align=center;verticalAlign=bottom;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="505" y="285" as="sourcePoint"/><mxPoint x="715" y="285" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m5" value="validate quantity 1..10   [fail -&gt; 400]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;align=left;verticalAlign=middle;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="715" y="330" as="sourcePoint"/><mxPoint x="715" y="356" as="targetPoint"/><Array as="points"><mxPoint x="790" y="330"/><mxPoint x="790" y="356"/></Array></mxGeometry></mxCell>
        <mxCell id="m6" value="findOneAndUpdate({_id, status:PUBLISHED, seatsRemaining &gt;= 2}, {$inc: -2})" style="edgeStyle=none;html=1;fontSize=9;align=center;verticalAlign=bottom;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="715" y="390" as="sourcePoint"/><mxPoint x="945" y="390" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m7" value="null  =&gt;  no seats  =&gt;  409 &quot;Only N seats remain&quot;" style="edgeStyle=none;html=1;fontSize=9;align=center;verticalAlign=bottom;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="945" y="440" as="sourcePoint"/><mxPoint x="715" y="440" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m8" value="updated event  =&gt;  seats were taken" style="edgeStyle=none;html=1;fontSize=9;align=center;verticalAlign=bottom;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="945" y="485" as="sourcePoint"/><mxPoint x="715" y="485" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m9" value="insert Booking{reference, CONFIRMED}" style="edgeStyle=none;html=1;fontSize=9;align=center;verticalAlign=bottom;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="715" y="530" as="sourcePoint"/><mxPoint x="945" y="530" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m10" value="on insert failure: COMPENSATE $inc seatsRemaining +2" style="edgeStyle=none;html=1;fontSize=9;align=center;verticalAlign=bottom;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="715" y="575" as="sourcePoint"/><mxPoint x="945" y="575" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m11" value="201 {reference, quantity}" style="edgeStyle=none;html=1;fontSize=9;align=center;verticalAlign=bottom;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="715" y="620" as="sourcePoint"/><mxPoint x="315" y="620" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m12" value="success screen with booking reference" style="edgeStyle=none;html=1;fontSize=9;align=center;verticalAlign=bottom;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="315" y="660" as="sourcePoint"/><mxPoint x="135" y="660" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seqNote" value="&lt;b&gt;The check and the decrement are ONE operation.&lt;/b&gt;&lt;br&gt;There is no moment between &quot;there is room&quot; and &quot;I took the room&quot;&lt;br&gt;in which another request can interleave.&lt;br&gt;&lt;br&gt;The naive alternative - read seatsRemaining, compare, then write -&lt;br&gt;has exactly that window, and oversells under US-10 AC4." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="60" y="700" width="420" height="120" as="geometry"/></mxCell>
        <mxCell id="seqNote2" value="&lt;b&gt;Why compensate instead of using a transaction?&lt;/b&gt;&lt;br&gt;MongoDB transactions need a replica set; a standalone mongod on one&lt;br&gt;EC2 instance is not one (decision D-009). Taking the seats FIRST means&lt;br&gt;the worst case is a temporarily unavailable seat, not an oversold event." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="540" y="700" width="480" height="100" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="6. Activity - W2 Cancel" id="p-act">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="a0" value="Attendee opens My Bookings" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="60" y="40" width="220" height="50" as="geometry"/></mxCell>
        <mxCell id="a1" value="List own bookings" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="90" y="120" width="160" height="40" as="geometry"/></mxCell>
        <mxCell id="a2" value="Select booking&lt;br&gt;and confirm cancel?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="a3" value="No change" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="340" y="210" width="120" height="40" as="geometry"/></mxCell>
        <mxCell id="a4" value="booking.attendeeId&lt;br&gt;== session user?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="60" y="320" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="a5" value="403 Forbidden" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="340" y="340" width="130" height="40" as="geometry"/></mxCell>
        <mxCell id="a6" value="booking.status&lt;br&gt;== CONFIRMED?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="60" y="450" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="a7" value="409 already cancelled&lt;br&gt;seats NOT returned twice" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="340" y="465" width="190" height="55" as="geometry"/></mxCell>
        <mxCell id="a8" value="ATOMIC: set status = CANCELLED&lt;br&gt;ONLY IF status is still CONFIRMED" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="a9" value="matched?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="90" y="670" width="160" height="70" as="geometry"/></mxCell>
        <mxCell id="a10" value="Increment event.seatsRemaining&lt;br&gt;by booking.quantity" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="680" width="220" height="50" as="geometry"/></mxCell>
        <mxCell id="a11" value="Booking CANCELLED,&lt;br&gt;seats released" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="620" y="675" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="c1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="a0" target="a1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c3" value="dismissed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c4" value="confirmed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="a2" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c5" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c6" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="a4" target="a6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c7" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="a6" target="a7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c8" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="a6" target="a8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="a8" target="a9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c10" value="no - lost the race" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="a9" target="a7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c11" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="a9" target="a10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="a10" target="a11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="actNote" value="&lt;b&gt;The STATUS TRANSITION is the atomic step, not the arithmetic.&lt;/b&gt;&lt;br&gt;Guarding only the seat maths is not enough: two simultaneous&lt;br&gt;cancellations of the same booking would each add the seats back,&lt;br&gt;INFLATING capacity so the event can later oversell.&lt;br&gt;Making the status change conditional means exactly one wins,&lt;br&gt;and only the winner increments. This mirrors the booking path -&lt;br&gt;both derive from R11.1." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="600" y="300" width="400" height="150" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="7. State Machines" id="p-state">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="smTitle1" value="&lt;b&gt;Event lifecycle&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="40" width="200" height="30" as="geometry"/></mxCell>
        <mxCell id="ev0" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;" vertex="1" parent="1"><mxGeometry x="80" y="100" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="ev1" value="PUBLISHED" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="170" y="95" width="140" height="45" as="geometry"/></mxCell>
        <mxCell id="ev2" value="CANCELLED" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="400" y="95" width="140" height="45" as="geometry"/></mxCell>
        <mxCell id="ev3" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="620" y="100" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="s1" value="organiser creates" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="ev0" target="ev1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s2" value="organiser cancels" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="ev1" target="ev2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="ev2" target="ev3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s4" value="update details / capacity" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="ev1" target="ev1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="evNote" value="Soft delete (D-005): the row is never removed,&lt;br&gt;because bookings still reference it." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="170" y="165" width="320" height="50" as="geometry"/></mxCell>
        <mxCell id="smTitle2" value="&lt;b&gt;Booking lifecycle&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="280" width="200" height="30" as="geometry"/></mxCell>
        <mxCell id="bk0" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;" vertex="1" parent="1"><mxGeometry x="80" y="340" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="bk1" value="CONFIRMED" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="170" y="335" width="140" height="45" as="geometry"/></mxCell>
        <mxCell id="bk2" value="CANCELLED" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="400" y="335" width="140" height="45" as="geometry"/></mxCell>
        <mxCell id="bk3" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="620" y="340" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="s5" value="seats decremented atomically" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="bk0" target="bk1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s6" value="attendee cancels; seats returned ONCE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="bk1" target="bk2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="bk2" target="bk3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="bkNote" value="Only CONFIRMED bookings count toward seats used.&lt;br&gt;There is no PENDING / PAID / REFUNDED state because&lt;br&gt;payments are out of scope - every extra state would need&lt;br&gt;its own guard and its own test." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="170" y="405" width="380" height="80" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="8. Data Model" id="p-er">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="eUser" value="&lt;b&gt;USER&lt;/b&gt;&lt;br&gt;---&lt;br&gt;PK  _id&lt;br&gt;UK  email&lt;br&gt;      passwordHash  (bcrypt)&lt;br&gt;      role  ORGANISER | ATTENDEE&lt;br&gt;      createdAt" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="80" width="260" height="130" as="geometry"/></mxCell>
        <mxCell id="eEvent" value="&lt;b&gt;EVENT&lt;/b&gt;&lt;br&gt;---&lt;br&gt;PK  _id&lt;br&gt;FK  organiserId  -&gt; USER&lt;br&gt;      title  3..120&lt;br&gt;      venue  3..160&lt;br&gt;      startsAt  (future at create)&lt;br&gt;      capacity  1..10000&lt;br&gt;      seatsRemaining  0..capacity&lt;br&gt;      price  &gt;= 0&lt;br&gt;      status  PUBLISHED | CANCELLED" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="440" y="60" width="280" height="190" as="geometry"/></mxCell>
        <mxCell id="eBooking" value="&lt;b&gt;BOOKING&lt;/b&gt;&lt;br&gt;---&lt;br&gt;PK  _id&lt;br&gt;UK  reference&lt;br&gt;FK  eventId  -&gt; EVENT&lt;br&gt;FK  attendeeId  -&gt; USER&lt;br&gt;      quantity  1..10&lt;br&gt;      status  CONFIRMED | CANCELLED&lt;br&gt;      createdAt" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="440" y="340" width="280" height="160" as="geometry"/></mxCell>
        <mxCell id="r1e" value="organises  1 : 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="eUser" target="eEvent"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r2e" value="makes  1 : 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="eUser" target="eBooking"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r3e" value="has  1 : 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="eEvent" target="eBooking"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="erNote" value="&lt;b&gt;Indexes that carry a rule, not just performance:&lt;/b&gt;&lt;br&gt;- unique index on USER.email enforces &quot;email already registered&quot;&lt;br&gt;  in the DATABASE, so a race between two registrations cannot&lt;br&gt;  create two accounts (US-01 AC2).&lt;br&gt;- unique index on BOOKING.reference guarantees US-09 AC5." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="80" y="280" width="320" height="120" as="geometry"/></mxCell>
        <mxCell id="erNote2" value="&lt;b&gt;seatsRemaining is denormalised on purpose.&lt;/b&gt;&lt;br&gt;It duplicates information derivable from the bookings, which is&lt;br&gt;normally bad practice. It is done here because it makes the&lt;br&gt;capacity check and the capacity change a single atomic step.&lt;br&gt;See D-004 for the trade-off and RSK-06 for the drift risk." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="790" y="60" width="330" height="130" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="9. Deployment" id="p-deploy">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="dNet" value="Internet" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="dUser" value="Browser&lt;br&gt;(marker / user)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="150" width="140" height="50" as="geometry"/></mxCell>
        <mxCell id="dAws" value="AWS - single EC2 instance" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=none;strokeColor=#d79b00;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="350" y="40" width="620" height="460" as="geometry"/></mxCell>
        <mxCell id="dSg" value="Security Group - inbound rules" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=none;strokeColor=#b85450;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="380" y="80" width="560" height="110" as="geometry"/></mxCell>
        <mxCell id="dP80" value="tcp/80  from 0.0.0.0/0" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="400" y="115" width="240" height="30" as="geometry"/></mxCell>
        <mxCell id="dP22" value="tcp/22  from MY IP ONLY" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="670" y="115" width="250" height="30" as="geometry"/></mxCell>
        <mxCell id="dP27" value="tcp/27017  NEVER OPENED" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="400" y="152" width="240" height="30" as="geometry"/></mxCell>
        <mxCell id="dNginx" value="nginx :80&lt;br&gt;serves built client,&lt;br&gt;proxies /api -&gt; :5000" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="400" y="230" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="dNode" value="Node API :5000&lt;br&gt;under pm2 (restart on boot)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="680" y="230" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="dMongo" value="mongod :27017&lt;br&gt;bound to 127.0.0.1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="680" y="350" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="d1" value="http" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="dUser" target="dP80"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="dP80" target="dNginx"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d3" value="/api/*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="dNginx" target="dNode"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="dNode" target="dMongo"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="depNote" value="&lt;b&gt;Three choices satisfying N6:&lt;/b&gt;&lt;br&gt;1. mongod binds to 127.0.0.1 - unreachable from the internet even&lt;br&gt;   though it runs on the same host. Port 27017 is never opened.&lt;br&gt;2. Port 22 restricted to one IP, not 0.0.0.0/0. SSH open to the world&lt;br&gt;   is the most common finding in student deployments.&lt;br&gt;3. Only port 80 is public. Node on 5000 is reached only via the nginx&lt;br&gt;   proxy, so there is ONE public entry point rather than two." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="60" y="540" width="480" height="150" as="geometry"/></mxCell>
        <mxCell id="depNote2" value="&lt;b&gt;Deploy a trivial version EARLY (mitigation for RSK-02).&lt;/b&gt;&lt;br&gt;Standing up a &quot;hello world&quot; on this instance during Iteration 1,&lt;br&gt;before there is anything worth deploying, separates&lt;br&gt;&quot;my code is broken&quot; from &quot;my deployment is broken&quot; -&lt;br&gt;two problems that are painful to debug at the same time&lt;br&gt;under deadline pressure." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="580" y="540" width="440" height="130" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
