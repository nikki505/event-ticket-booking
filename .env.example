# Copy this file to .env and fill in real values.
# .env is git-ignored and must NEVER be committed (requirement N3).

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/eventtickets
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGO_URI=

# --- Authentication ---
# Long random string used to sign session tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Client ---
# Base URL the browser uses to reach the API.
# Local:  http://localhost:5000
# EC2:    http://<public-ip-or-dns>
CLIENT_API_BASE_URL=http://localhost:5000
